---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  pubDate?: Date;
  authors?: string[];
}

const {
  title,
  description,
  image,
  type = 'website',
  pubDate,
  authors = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resolvedImage = image && typeof image !== 'string'
  ? (await getImage({ src: image, width: 1200, height: 630, fit: 'cover' })).src
  : image;
const imageURL = resolvedImage ? new URL(resolvedImage, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2e3440" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="Manoj Babu Katragadda — Blog" href={`${base}rss.xml`} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {type === 'article' && authors.map((author) => <meta property="article:author" content={author} />)}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <title>tardunge</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const initialTheme = savedTheme || systemTheme;
      document.documentElement.dataset.theme = initialTheme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', initialTheme === 'dark' ? '#2e3440' : '#eceff4');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
  <script>
    const root = document.documentElement;
    const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

    const updateThemeControl = () => {
      const currentTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
      themeToggle?.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
      themeToggle?.setAttribute('title', `Switch to ${nextTheme} theme`);
      themeColor?.setAttribute('content', currentTheme === 'dark' ? '#2e3440' : '#eceff4');
    };

    updateThemeControl();

    themeToggle?.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = nextTheme;
      localStorage.setItem('theme', nextTheme);
      updateThemeControl();
    });
  </script>
</html>
