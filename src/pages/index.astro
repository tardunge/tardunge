---
import Layout from '../layouts/Layout.astro';
import EditorHeader from '../components/EditorHeader.astro';
import EditorStatusline from '../components/EditorStatusline.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeUrl = `${base}manoj-babu-katragadda-resume.pdf`;

const projects = [
  {
    index: '01',
    title: 'Zest',
    kind: 'MLOps platform',
    description:
      'A declarative ML lifecycle platform with 17 resource types, an AST-based compiler, dependency resolution, artifact versioning, and isolated workspaces across test, staging, and production.',
    impact: 'One Python SDK from data segmentation to model deployment.',
    stack: ['Python', 'FastAPI', 'React', 'Spark'],
    articleHref: '/blog/what-we-learned-building-our-ml-platform',
    articleLabel: 'Inside the Zest compiler',
  },
  {
    index: '02',
    title: 'Lakehouse Spark Core',
    kind: 'Data platform',
    description:
      'A composable PySpark ETL framework with lifecycle hooks, plugin-based extractors and compactors, plus write-audit-publish data quality gates.',
    impact: 'Cut per-pipeline code by 75% and became the execution backbone for ML operations.',
    stack: ['PySpark', 'Iceberg', 'Kubernetes', 'WAP'],
    articleHref: '/blog/building-a-composable-etl-framework',
    articleLabel: 'Read the framework design',
  },
  {
    index: '03',
    title: 'Iceforge',
    kind: 'Iceberg tooling',
    description:
      'A single-binary Apache Iceberg table analyzer serving a REST API and embedded interface for file distribution, snapshot health, and orphan detection—without Spark or JVM overhead.',
    impact: 'Fast operational insight into lakehouse table health.',
    stack: ['Rust', 'Axum', 'iceberg-rust', 'React'],
    articleHref: '/blog/building-our-lakehouse-with-iceberg',
    articleLabel: 'Read the lakehouse architecture',
  },
  {
    index: '04',
    title: 'Prefect Spark on Kubernetes',
    kind: 'Open source',
    description:
      'A Prefect integration for scheduling, orchestrating, and monitoring Apache Spark jobs through the Spark-on-Kubernetes operator.',
    impact: 'Presented at PyCon Malaysia 2023 and released for the wider data community.',
    stack: ['Python', 'Prefect', 'Spark', 'Kubernetes'],
    href: 'https://github.com/tardunge/prefect-spark-on-k8s-operator',
    articleHref: '/blog/running-spark-on-kubernetes',
    articleLabel: 'Read the Kubernetes playbook',
  },
];

const experience = [
  {
    company: 'ZerotoOne AI',
    location: 'Remote · Bali',
    period: 'Apr 2025 — Apr 2026',
    roles: [{ title: 'Principal Platform Engineer · Consultant', period: 'Apr 2025 — Apr 2026' }],
    summary:
      'Built the data and ML platform layer: cost-efficient Spark on Kubernetes, declarative MLOps, composable lakehouse execution, custom Airflow providers, and Rust-native Iceberg tooling.',
    articleHref: '/blog',
  },
  {
    company: 'AirAsia Berhad',
    location: 'Kuala Lumpur · Malaysia',
    period: 'Sep 2019 — Feb 2024',
    roles: [
      { title: 'Principal Engineer', period: 'Jan 2022 — Feb 2024' },
      { title: 'Lead Data Engineer · Experimentation', period: 'Jan 2021 — Dec 2021' },
      { title: 'Senior Data Engineer · Experimentation', period: 'Sep 2019 — Dec 2020' },
    ],
    summary:
      'Pioneered data mesh adoption, designed event-driven backend foundations, built experimentation systems, and mentored engineers across the platform, software, and data organizations.',
    articleHref: null,
  },
  {
    company: 'honestbee',
    location: 'Singapore · Bangalore',
    period: 'Jun 2018 — Mar 2019',
    roles: [{ title: 'Data Engineer II', period: 'Jun 2018 — Mar 2019' }],
    summary:
      'Designed ETL systems with Airflow, Spark, AWS Glue, and Redshift; partnered with data scientists to operationalize model workloads on Kubernetes.',
    articleHref: null,
  },
  {
    company: 'Zivame',
    location: 'Bangalore · India',
    period: 'Aug 2015 — May 2018',
    roles: [
      { title: 'Senior Software Engineer', period: 'Apr 2016 — May 2018' },
      { title: 'Software Engineer · Full stack', period: 'Aug 2015 — Mar 2016' },
    ],
    summary:
      'Built recommendation and search systems, customer-facing product discovery, Java APIs, and the infrastructure behind caching and centralized service observability.',
    articleHref: null,
  },
  {
    company: 'Kore.ai',
    location: 'Hyderabad · India',
    period: 'Sep 2014 — Jul 2015',
    roles: [{ title: 'Software Engineer', period: 'Sep 2014 — Jul 2015' }],
    summary: 'Developed backend APIs in Node.js at the start of a decade-long engineering career.',
    articleHref: null,
  },
];

const publishedPosts = await getPublishedPosts();
const pinnedPostId = 'spark-merge-optimization-from-60-to-4-minutes';
const pinnedPost = publishedPosts.find((post) => post.id === pinnedPostId);
const latestPosts = (
  pinnedPost
    ? [pinnedPost, ...publishedPosts.filter((post) => post.id !== pinnedPostId)]
    : publishedPosts
).slice(0, 3);

const skillGroups = [
  { name: 'infra', skills: ['Kubernetes', 'Terraform', 'Docker', 'AWS', 'GCP'] },
  { name: 'data', skills: ['Spark', 'Iceberg', 'Trino', 'Airflow', 'Prefect'] },
  { name: 'languages', skills: ['Go', 'Python', 'Rust', 'Java', 'Node.js', 'TypeScript', 'Lua', 'Nix'] },
  { name: 'environment', skills: ['Unix', 'Zsh', 'Tmux', 'Neovim', 'OMP'] },
  { name: 'databases', skills: ['Postgres', 'BigQuery', 'Redshift', 'Talaria'] },
];
---

<Layout
  title="Manoj Babu Katragadda — Fractional Engineer, Data Platforms"
  description="Fractional engineer for data and platform systems, based in Bali and helping teams build dependable infrastructure."
>
  <div class="page-frame">
    <main class="editor" id="main-content">
      <EditorHeader active="about" home />

      <section class="editor-buffer hero" id="about" aria-labelledby="hero-title">
        <div class="line-numbers hero-lines" aria-hidden="true">
          <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span>
        </div>
        <div class="buffer-content hero-content">
          <p class="code-line reveal delay-1">
            <span class="syntax-keyword">const</span>
            <span class="syntax-property"> role</span>
            <span class="syntax-operator"> = </span>
            <span class="syntax-string">"Fractional Engineer — Data Platforms"</span><span class="syntax-operator">;</span>
          </p>
          <h1 id="hero-title" class="reveal delay-2">
            Built platforms that make<br />{' '}
            <span>hard systems feel routine.</span>
          </h1>
          <p class="hero-intro reveal delay-3">
            I’m Manoj Babu Katragadda. I design the infrastructure behind data, ML, and backend systems—turning distributed complexity into dependable paths for teams to ship.
          </p>
          <p class="hero-fit reveal delay-3">
            <span>Available:</span> focused fractional engagements where platform complexity, delivery pressure, and the cost of a wrong decision are all high.
          </p>
          <div class="hero-actions reveal delay-4">
            <a class="button primary" href="#engage">Discuss an engagement <span aria-hidden="true">↓</span></a>
            <a class="button secondary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
          </div>

          <dl class="impact-grid reveal delay-4" aria-label="Selected outcomes">
            <div>
              <dt>90%</dt>
              <dd>lower Spark infrastructure cost</dd>
            </div>
            <div>
              <dt>10TB+</dt>
              <dd>production datasets processed</dd>
            </div>
            <div>
              <dt>75%</dt>
              <dd>less code per data pipeline</dd>
            </div>
          </dl>

          <div class="about-grid">
            <div>
              <p class="section-kicker">// operating principles</p>
              <h2>Build the paved road.<br />Keep the escape hatch.</h2>
            </div>
            <div class="about-copy">
              <p>
                I build paved roads for engineers: declarative interfaces, safe defaults, observable execution, and explicit escape hatches. The goal is leverage without loss of control.
              </p>
              <p>
                Over the last decade, I’ve moved from full-stack systems into experimentation, data platforms, and organization-wide infrastructure. Each layer taught me the same thing: abstractions earn trust only when they survive production.
              </p>
            </div>
          </div>

          <div class="skills-console" aria-label="Core technology stack">
            <div class="console-title"><span>stack.lua</span><span>{skillGroups.length} groups</span></div>
            <div class="console-body">
              {skillGroups.map((group, index) => (
                <div class="skill-line">
                  <span class="console-prompt" aria-hidden="true">{index + 1}:</span>
                  <span class="skill-expression">
                    <span class="syntax-property">{group.name}</span>
                    <span class="syntax-operator"> = &#123; </span>
                    {group.skills.map((skill, skillIndex) => (
                      <><span class="syntax-string">"{skill}"</span>{skillIndex < group.skills.length - 1 && <span class="syntax-operator">, </span>}</>
                    ))}
                    <span class="syntax-operator"> &#125;</span>
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="editor-buffer section" id="work" aria-labelledby="work-title">
        <div class="line-numbers" aria-hidden="true"><span>42</span><span>43</span><span>44</span><span>45</span><span>46</span></div>
        <div class="buffer-content">
          <div class="section-heading">
            <div>
              <p class="section-kicker">// selected work</p>
              <h2 id="work-title">Systems with leverage.</h2>
            </div>
            <p>Products, primitives, and open-source tools built to make complex infrastructure easier to operate.</p>
          </div>

          <div class="project-list">
            {projects.map((project) => (
              <article class="project-card">
                <div class="project-index">{project.index}</div>
                <div class="project-main">
                  <div class="project-title-row">
                    <div>
                      <p class="project-kind">{project.kind}</p>
                      <h3>
                        {project.href ? (
                          <a href={project.href} target="_blank" rel="noreferrer">{project.title} <span aria-hidden="true">↗</span></a>
                        ) : project.title}
                      </h3>
                    </div>
                    <div class="project-stack" aria-label={`${project.title} technologies`}>
                      {project.stack.map((item) => <span>{item}</span>)}
                    </div>
                  </div>
                  <p class="project-description">{project.description}</p>
                  <p class="project-impact"><span class="result-label">result</span><span>{project.impact}</span></p>
                  <a class="related-reading" href={project.articleHref}>
                    {project.articleLabel} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="editor-buffer section engagement-section" id="engage" aria-labelledby="engagement-title">
        <div class="line-numbers" aria-hidden="true"><span>82</span><span>83</span><span>84</span><span>85</span><span>86</span></div>
        <div class="buffer-content">
          <div class="engagement-intro">
            <div>
              <p class="section-kicker">// fractional engineering</p>
              <h2 id="engagement-title">Speed comes from<br />fewer wrong turns.</h2>
            </div>
            <p>
              Fractional engineering works when delay is expensive. I narrow the scope, make the difficult architecture calls, ship production code, and leave the team with systems it can own.
            </p>
          </div>

          <div class="engagement-panel">
            <div class="engagement-triggers">
              <p class="engagement-label">bring_me_in_when =</p>
              <ol>
                <li><span>01</span><p>A data platform is too slow, expensive, or unreliable.</p></li>
                <li><span>02</span><p>A platform initiative is stuck between design and production.</p></li>
                <li><span>03</span><p>The team needs hands-on senior execution, not another strategy deck.</p></li>
                <li><span>04</span><p>A costly technical decision has to be made correctly—and quickly.</p></li>
              </ol>
            </div>

            <aside class="engagement-model" aria-label="Fractional engagement delivery model">
              <div class="engagement-model-title">
                <span>engagement.lua</span>
                <span>active</span>
              </div>
              <div class="engagement-model-body">
                <div class="engagement-contract" aria-label="Engagement properties">
                  <p><span class="syntax-property">mode</span><span class="syntax-operator"> = </span><span class="syntax-string">"hands-on"</span></p>
                  <p><span class="syntax-property">scope</span><span class="syntax-operator"> = </span><span class="syntax-string">"focused"</span></p>
                  <p><span class="syntax-property">owner</span><span class="syntax-operator"> = </span><span class="syntax-string">"your team"</span></p>
                </div>
                <div class="engagement-flow" aria-label="Scope tightly, ship the critical path, transfer ownership">
                  <span>scope tightly</span>
                  <span aria-hidden="true">→</span>
                  <span>ship the critical path</span>
                  <span aria-hidden="true">→</span>
                  <span>transfer ownership</span>
                </div>
                <a class="button primary" href="#contact">Bring me the bottleneck <span aria-hidden="true">↓</span></a>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="editor-buffer section" id="experience" aria-labelledby="experience-title">
        <div class="line-numbers" aria-hidden="true"><span>88</span><span>89</span><span>90</span><span>91</span><span>92</span></div>
        <div class="buffer-content">
          <div class="section-heading">
            <div>
              <p class="section-kicker">// career.log</p>
              <h2 id="experience-title">A decade in the stack.</h2>
            </div>
            <p>From product APIs to the platforms beneath large-scale data and ML workloads.</p>
          </div>

          <ol class="timeline">
            {experience.map((job, index) => (
              <li class="timeline-item">
                <div class="timeline-marker" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span></div>
                <div class="timeline-meta">
                  <p class="timeline-period">{job.period}</p>
                  <p>{job.location}</p>
                </div>
                <div class="timeline-content">
                  <h3>{job.company}</h3>
                  <div class="role-list">
                    {job.roles.map((role) => (
                      <div class="role-entry">
                        <span>{role.title}</span>
                        <small>{role.period}</small>
                      </div>
                    ))}
                  </div>
                  <p>{job.summary}</p>
                  {job.articleHref && (
                    <a class="related-reading" href={job.articleHref}>
                      Read the engineering notes <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>

          <div class="education-row">
            <div>
              <p class="section-kicker">// education</p>
              <h3>Indian Institute of Technology Kharagpur</h3>
              <p>Bachelor of Technology · Mining Engineering</p>
            </div>
            <p class="education-date">2009 — 2014</p>
          </div>

          <a class="text-link" href={resumeUrl} target="_blank">Read the complete résumé <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="editor-buffer section" id="writing" aria-labelledby="writing-title">
        <div class="line-numbers" aria-hidden="true"><span>131</span><span>132</span><span>133</span><span>134</span></div>
        <div class="buffer-content">
          <div class="section-heading">
            <div>
              <p class="section-kicker">// blog</p>
              <h2 id="writing-title">Latest writing.</h2>
            </div>
            <div class="section-heading-action">
              <a class="text-link" href="/blog">Open all articles <span aria-hidden="true">→</span></a>
            </div>
          </div>

          <div class="homepage-posts">
            {latestPosts.map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                slug={post.id}
                heroImage={post.data.heroImage}
              />
            ))}
          </div>
        </div>
      </section>

      <section class="editor-buffer contact-section" id="contact" aria-labelledby="contact-title">
        <div class="line-numbers" aria-hidden="true"><span>168</span><span>169</span><span>170</span><span>171</span></div>
        <div class="buffer-content contact-content">
          <p class="section-kicker">// contact.sh</p>
          <h2 id="contact-title">Let’s make the difficult part boring.</h2>
          <p>
            Send me the problem, the constraints, and what needs to move faster. I’ll tell you directly whether I can help and what a focused engagement should cover.
          </p>
          <div class="contact-meta" aria-label="Contact details">
            <span>problem</span><span>constraints</span><span>timeline</span><span>UTC+8</span>
          </div>
          <a class="email-link" href="mailto:manojbabukatragadda@gmail.com?subject=Fractional%20engineering%20engagement">
            manojbabukatragadda@gmail.com <span aria-hidden="true">↗</span>
          </a>
          <div class="social-links">
            <a href="https://github.com/tardunge" target="_blank" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <a href="https://linkedin.com/in/manojbabuiit" target="_blank" rel="me noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
            <a href={resumeUrl} target="_blank">Résumé <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <EditorStatusline file="portfolio.astro" position="Ln 171, Col 1" />
    </main>
  </div>

  <script>
    const bufferTabs = document.querySelector<HTMLElement>('.buffer-tabs');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
    const navTabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.buffer-tab'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));

    const activateSection = (id: string) => {
      navTabs.forEach((link) => {
        const active = link.dataset.sectionLink === id || (id === 'writing' && link.dataset.navId === 'blog');
        link.classList.toggle('active', active);
        if (active) {
          if (link.dataset.sectionLink) link.setAttribute('aria-current', 'location');
          const hiddenLeft = link.offsetLeft < (bufferTabs?.scrollLeft ?? 0);
          const hiddenRight = link.offsetLeft + link.offsetWidth > (bufferTabs?.scrollLeft ?? 0) + (bufferTabs?.clientWidth ?? 0);
          if (bufferTabs && (hiddenLeft || hiddenRight)) {
            const targetLeft = link.offsetLeft - (bufferTabs.clientWidth - link.offsetWidth) / 2;
            bufferTabs.scrollTo({ left: Math.max(0, targetLeft), behavior: reducedMotion ? 'auto' : 'smooth' });
          }
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    sectionLinks.forEach((link) => {
      link.addEventListener('click', () => activateSection(link.dataset.sectionLink ?? 'about'));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) activateSection(visible.target.id);
      },
      { rootMargin: '-18% 0px -68% 0px', threshold: [0, 0.2, 0.5] },
    );

    sections.forEach((section) => observer.observe(section));
  </script>
</Layout>
