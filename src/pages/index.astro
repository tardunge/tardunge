  <script>
    const bufferTabs = document.querySelector<HTMLElement>('.buffer-tabs');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
    const navTabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.buffer-tab'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));

    const activateSection = (id: string) => {
      navTabs.forEach((link) => {
        const active = link.dataset.sectionLink === id || (id === 'writing' && link.dataset.navId === 'blog');
        link.classList.toggle('active', active);
        if (active) {
          if (link.dataset.sectionLink) link.setAttribute('aria-current', 'location');
          const hiddenLeft = link.offsetLeft < (bufferTabs?.scrollLeft ?? 0);
          const hiddenRight = link.offsetLeft + link.offsetWidth > (bufferTabs?.scrollLeft ?? 0) + (bufferTabs?.clientWidth ?? 0);
          if (bufferTabs && (hiddenLeft || hiddenRight)) {
            const targetLeft = link.offsetLeft - (bufferTabs.clientWidth - link.offsetWidth) / 2;
            bufferTabs.scrollTo({ left: Math.max(0, targetLeft), behavior: reducedMotion ? 'auto' : 'smooth' });
          }
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    sectionLinks.forEach((link) => {
      link.addEventListener('click', () => activateSection(link.dataset.sectionLink ?? 'about'));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) activateSection(visible.target.id);
      },
      { rootMargin: '-18% 0px -68% 0px', threshold: [0, 0.2, 0.5] },
    );

    sections.forEach((section) => observer.observe(section));
  </script>
</Layout>
