const publishedPosts = await getPublishedPosts();
const pinnedPostId = 'spark-merge-optimization-from-60-to-4-minutes';
const pinnedPost = publishedPosts.find((post) => post.id === pinnedPostId);
const latestPosts = (
  pinnedPost
