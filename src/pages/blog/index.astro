---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EditorHeader from '../../components/EditorHeader.astro';
import EditorStatusline from '../../components/EditorStatusline.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog — Manoj Babu Katragadda"
  description="Field-tested writing on data platforms, Spark, Iceberg, MLOps, Kubernetes, and the operational details behind dependable systems."
  image={posts[0]?.data.heroImage}
>
  <div class="page-frame blog-page-frame">
    <main class="editor blog-editor" id="main-content">
      <EditorHeader active="blog" />

      <section class="blog-index-buffer" aria-label="Articles">
        <div class="blog-index-rail" aria-hidden="true">
          <span>01</span><span>02</span><span>03</span><span>04</span><span>05</span><span>06</span><span>07</span><span>08</span>
        </div>
        <div class="blog-index-content">
          <div class="blog-post-grid">
            <div class="blog-grid">
              {posts.map((post) => (
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  slug={post.id}
                  heroImage={post.data.heroImage}
                />
              ))}
            </div>
          </div>
        </div>
      </section>

      <EditorStatusline file="blog/index.astro" position={`8 articles · ${posts.length} open`} />
    </main>
  </div>
</Layout>
